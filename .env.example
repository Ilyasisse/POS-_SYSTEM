# Required to start the app
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for Prisma migrations and direct database access
DIRECT_URL=

# Supplier receipt storage
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SUPPLIER_RECEIPTS_BUCKET=supplier-receipts
SUPABASE_PRONUNCIATION_BUCKET=pronunciations

# Supplier invoice extraction
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=

# Inventory alert emails
RESEND_API_KEY=
INVENTORY_ALERT_EMAIL_FROM=
INVENTORY_ALERT_EMAIL_TO=

# Kitchen WebSocket server
NEXT_PUBLIC_KITCHEN_SOCKET_URL=ws://localhost:3001
KITCHEN_WS_PORT=3001
KITCHEN_WS_HOST=0.0.0.0

# Optional protected endpoints
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_CASHIER_ID=
CRON_SECRET=
