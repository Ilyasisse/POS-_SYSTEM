generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id
  phoneNumber   String?     @unique
  fullName      String
  role          UserRole    @default(CASHIER)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  email         String      @unique
  station       Station?
  orders        Order[]     @relation("Cashier")
  waiterOrders  Order[]     @relation("WaiterOrders")
  assignedItems OrderItem[] @relation("AssignedOrderItems")
  payments      Payment[]
  shifts        Shift[]

  @@index([role, isActive])
  @@index([station])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  iconUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  station   Station?
  products  Product[]

  @@index([isActive, sortOrder])
  @@index([station])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  sku         String?     @unique
  description String?
  imageUrl    String?
  pronunciationAudioUrl String?
  isActive    Boolean     @default(true)
  isPopular   Boolean     @default(false)
  price       Decimal
  cost        Decimal?
  categoryId  String
  trackStock  Boolean     @default(false)
  stockQty    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  modifiers   Modifier[]
  orderItems  OrderItem[]
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([categoryId, isActive])
  @@index([price, name])
}

model ModifierGroup {
  id         String     @id @default(cuid())
  name       String     @unique
  isRequired Boolean    @default(false)
  minSelect  Int        @default(0)
  maxSelect  Int        @default(5)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  modifiers  Modifier[]

  @@index([isActive])
}

model Modifier {
  id                 String              @id @default(cuid())
  productId          String
  modifierGroupId    String
  name               String
  price              Decimal
  pronunciationAudioUrl String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@index([productId])
  @@index([modifierGroupId])
}

model Table {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([isActive])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  type        OrderType   @default(DINE_IN)
  status      OrderStatus @default(OPEN)
  tableId     String?
  cashierId   String?
  waiterId    String?
  notes       String?
  total       Decimal
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  closedAt    DateTime?
  cashier     User?       @relation("Cashier", fields: [cashierId], references: [id])
  waiter      User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  table       Table?      @relation(fields: [tableId], references: [id])
  orderItems  OrderItem[]
  payments    Payment[]

  @@index([status])
  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([waiterId, createdAt])
  @@index([tableId, createdAt])
}

model OrderItem {
  id             String              @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  qty            Int
  unitPrice      Decimal
  lineTotal      Decimal
  createdAt      DateTime            @default(now())
  assignedUserId String?
  station        Station?
  assignedUser   User?               @relation("AssignedOrderItems", fields: [assignedUserId], references: [id])
  order          Order               @relation(fields: [orderId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  modifiers      OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([station])
  @@index([assignedUserId])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  modifierId   String
  modifierName String
  qty          Int       @default(1)
  price        Decimal
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, modifierId])
  @@index([modifierId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  cashierId   String
  cashierName String
  method      PaymentMethod
  amountPaid  Decimal
  reference   String?
  createdAt   DateTime      @default(now())
  cashier     User          @relation(fields: [cashierId], references: [id])
  order       Order         @relation(fields: [orderId], references: [id])

  @@index([createdAt])
  @@index([orderId])
  @@index([cashierId, createdAt])
}

model Shift {
  id            String    @id @default(cuid())
  userId        String
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openingAmount Decimal   @default(0)
  closingAmount Decimal?
  waiter        User      @relation(fields: [userId], references: [id])

  @@index([openedAt])
  @@index([userId, openedAt])
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  COOK
  BARISTA
  Cabitaan
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  MYCASH
  GOLIS
  Dahabshiil
  OTHER
}

enum Station {
  CUNTO_SOOMAALI
  FAST_FOOD
  CABITAAN
  BARISTA
}
