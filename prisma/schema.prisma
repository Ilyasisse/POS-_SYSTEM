generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  String                        @id
  phoneNumber                         String?                       @unique
  fullName                            String
  role                                UserRole                      @default(CASHIER)
  isActive                            Boolean                       @default(true)
  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt
  email                               String                        @unique
  station                             Station?
  orders                              Order[]                       @relation("Cashier")
  waiterOrders                        Order[]                       @relation("WaiterOrders")
  assignedItems                       OrderItem[]                   @relation("AssignedOrderItems")
  claimedKitchenTickets               KitchenTicketState[]          @relation("KitchenTicketClaimant")
  payments                            Payment[]
  shifts                              Shift[]                       @relation("WaiterShifts")
  shiftsSettled                       Shift[]                       @relation("ShiftSettledBy")
  waiterBalanceInitialization         WaiterBalanceInitialization?  @relation("WaiterBalanceOwner")
  waiterBalanceInitializationsCreated WaiterBalanceInitialization[] @relation("WaiterBalanceCreatedBy")
  supplierDeliveriesVerified          SupplierDelivery[]            @relation("SupplierDeliveryVerifiedBy")
  supplierDeliveriesRejected          SupplierDelivery[]            @relation("SupplierDeliveryRejectedBy")
  supplierBillsSettled                SupplierBill[]                @relation("SupplierBillSettledBy")
  supplierPaymentsRecorded            SupplierPayment[]             @relation("SupplierPaymentRecordedBy")
  supplyPurchasesCreated              SupplyPurchase[]              @relation("SupplyPurchaseCreatedBy")
  auditLogsCreated                    AuditLog[]                    @relation("AuditLogActor")
  cafeSettingsUpdated                 CafeSetting[]                 @relation("CafeSettingUpdatedBy")

  @@index([role, isActive])
  @@index([station])
}

model CafeSetting {
  id                     String   @id @default("default")
  businessName           String   @default("Mash Allah Cafe")
  currencyCode           String   @default("USD")
  timezone               String   @default("Africa/Nairobi")
  businessDayStartMinute Int      @default(420)
  businessDayEndMinute   Int      @default(300)
  weekStartDay           Int      @default(6)
  updatedByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  updatedBy              User?    @relation("CafeSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String?
  action            String
  entityType        String
  entityId          String
  reason            String?
  previousValue     Json?
  newValue          Json?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())
  actor             User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  iconUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  station   Station?
  products  Product[]

  @@index([isActive, sortOrder])
  @@index([station])
}

model Product {
  id   String @id @default(cuid())
  name String

  description           String?
  imageUrl              String?
  pronunciationAudioUrl String?
  isActive              Boolean                @default(true)
  isPopular             Boolean                @default(false)
  price                 Decimal
  cost                  Decimal?
  categoryId            String
  trackStock            Boolean                @default(false)
  stockQty              Int                    @default(0)
  lowStockThreshold     Int                    @default(5)
  inventoryAlertStatus  InventoryAlertStatus   @default(OK)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  modifiers             Modifier[]
  orderItems            OrderItem[]
  supplierDeliveryItems SupplierDeliveryItem[]
  category              Category               @relation(fields: [categoryId], references: [id])

  @@index([categoryId, isActive])
  @@index([trackStock, inventoryAlertStatus])
  @@index([price, name])
}

model InventorySupply {
  id                    String                 @id @default(cuid())
  name                  String
  unit                  String                 @default("unit")
  stockQty              Int                    @default(0)
  lowStockThreshold     Int                    @default(5)
  inventoryAlertStatus  InventoryAlertStatus   @default(OK)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  movements             InventoryMovement[]
  supplierDeliveryItems SupplierDeliveryItem[]

  @@unique([name, unit])
  @@index([isActive, inventoryAlertStatus])
}

/// Supply-only inventory history.
/// Product stock still lives on Product, but product changes are no longer written here
/// because the Supabase "InventoryMovement"."productId" column was intentionally removed.
model InventoryMovement {
  id             String           @id @default(cuid())
  supplyId       String?
  itemName       String
  itemType       String
  delta          Int
  quantityBefore Int
  quantityAfter  Int
  reason         String
  note           String?
  createdAt      DateTime         @default(now())
  supply         InventorySupply? @relation(fields: [supplyId], references: [id], onDelete: SetNull)

  @@index([supplyId, createdAt])
  @@index([createdAt])
}

model ModifierGroup {
  id         String     @id @default(cuid())
  name       String     @unique
  isRequired Boolean    @default(false)
  minSelect  Int        @default(0)
  maxSelect  Int        @default(5)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  modifiers  Modifier[]

  @@index([isActive])
}

model Modifier {
  id                    String              @id @default(cuid())
  productId             String
  modifierGroupId       String
  name                  String
  price                 Decimal
  pronunciationAudioUrl String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  modifierGroup         ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  product               Product             @relation(fields: [productId], references: [id])
  orderItemModifiers    OrderItemModifier[]

  @@index([productId])
  @@index([modifierGroupId])
}

model Table {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([isActive])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        Int                 @unique @default(autoincrement())
  type               OrderType           @default(DINE_IN)
  status             OrderStatus         @default(OPEN)
  tableId            String?
  cashierId          String?
  waiterId           String?
  notes              String?
  total              Decimal
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedAt           DateTime?
  cashier            User?               @relation("Cashier", fields: [cashierId], references: [id])
  waiter             User?               @relation("WaiterOrders", fields: [waiterId], references: [id])
  table              Table?              @relation(fields: [tableId], references: [id])
  orderItems         OrderItem[]
  payments           Payment[]
  kitchenTicketState KitchenTicketState?

  @@index([status])
  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([waiterId, createdAt])
  @@index([tableId, createdAt])
}

model OrderItem {
  id             String              @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  qty            Int
  unitPrice      Decimal
  lineTotal      Decimal
  createdAt      DateTime            @default(now())
  assignedUserId String?
  station        Station?
  assignedUser   User?               @relation("AssignedOrderItems", fields: [assignedUserId], references: [id])
  order          Order               @relation(fields: [orderId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  modifiers      OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([station])
  @@index([assignedUserId])
}

/// Durable kitchen workflow state for an order. The order and its ticket state
/// are created atomically so Supabase Realtime can always rebuild a snapshot.
model KitchenTicketState {
  orderId             String                      @id
  pickupStatus        KitchenPickupStatus         @default(PREPARING)
  customerName        String?
  claimedByWaiterId   String?
  claimedByWaiterName String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  order               Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedByWaiter     User?                       @relation("KitchenTicketClaimant", fields: [claimedByWaiterId], references: [id], onDelete: SetNull)
  stationStates       KitchenTicketStationState[]

  @@index([pickupStatus, updatedAt])
  @@index([claimedByWaiterId])
}

/// One independently updateable kitchen status per order station.
model KitchenTicketStationState {
  orderId   String
  station   Station
  status    KitchenStationTicketStatus @default(NEW)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  ticket    KitchenTicketState         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@id([orderId, station])
  @@index([station, status])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  modifierId   String
  modifierName String
  qty          Int       @default(1)
  price        Decimal
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, modifierId])
  @@index([modifierId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  cashierId   String
  cashierName String
  method      PaymentMethod
  amountPaid  Decimal
  reference   String?
  createdAt   DateTime      @default(now())
  cashier     User          @relation(fields: [cashierId], references: [id])
  order       Order         @relation(fields: [orderId], references: [id])

  @@unique([method, reference])
  @@index([createdAt])
  @@index([orderId])
  @@index([cashierId, createdAt])
}

model Shift {
  id              String    @id @default(cuid())
  userId          String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingAmount   Decimal   @default(0)
  closingAmount   Decimal?
  businessDate    DateTime? @db.Date
  reportedSales   Decimal?
  settledByUserId String?
  updatedAt       DateTime  @updatedAt
  waiter          User      @relation("WaiterShifts", fields: [userId], references: [id])
  settledBy       User?     @relation("ShiftSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, businessDate])
  @@index([openedAt])
  @@index([userId, openedAt])
  @@index([settledByUserId])
}

model WaiterBalanceInitialization {
  id                    String   @id @default(cuid())
  waiterId              String   @unique
  effectiveBusinessDate DateTime @db.Date
  openingBalance        Decimal
  createdByUserId       String
  createdAt             DateTime @default(now())
  waiter                User     @relation("WaiterBalanceOwner", fields: [waiterId], references: [id])
  createdBy             User     @relation("WaiterBalanceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
}

model Supplier {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  contactName String?
  phone       String?
  email       String?
  googleEmail String?            @unique
  notes       String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deliveries  SupplierDelivery[]
  bills       SupplierBill[]

  @@index([isActive, name])
}

model SupplierDelivery {
  id                 String                 @id @default(cuid())
  supplierId         String
  uploadedByEmail    String
  receiptObjectPath  String
  receiptContentType String
  status             SupplierDeliveryStatus @default(PENDING_EXTRACTION)
  invoiceNumber      String?
  receiptDate        DateTime?
  deliveryDate       DateTime?
  subtotalAmount     Decimal?
  taxAmount          Decimal?
  discountAmount     Decimal?
  totalAmount        Decimal?
  extractedText      String?
  reviewedText       String?
  ocrConfidence      Float?
  ocrError           String?
  aiRawResponse      Json?
  aiParsedJson       Json?
  aiError            String?
  notes              String?
  submittedAt        DateTime               @default(now())
  verifiedAt         DateTime?
  verifiedByUserId   String?
  inventoryUpdatedAt DateTime?
  rejectedAt         DateTime?
  rejectedByUserId   String?
  rejectionReason    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  supplier           Supplier               @relation(fields: [supplierId], references: [id])
  verifiedBy         User?                  @relation("SupplierDeliveryVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  rejectedBy         User?                  @relation("SupplierDeliveryRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  items              SupplierDeliveryItem[]
  bill               SupplierBill?

  @@index([supplierId, submittedAt])
  @@index([status, submittedAt])
}

model SupplierDeliveryItem {
  id                String           @id @default(cuid())
  deliveryId        String
  productId         String?
  inventorySupplyId String?
  aiItemName        String
  matchedItemName   String?
  quantity          Decimal?
  verifiedQuantity  Int?
  unitPrice         Decimal?
  totalPrice        Decimal?
  confidenceScore   Float?
  needsManualReview Boolean          @default(false)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  delivery          SupplierDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  inventorySupply   InventorySupply? @relation(fields: [inventorySupplyId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([productId])
  @@index([inventorySupplyId])
}

model SupplierBill {
  id              String                @id @default(cuid())
  supplierId      String
  deliveryId      String                @unique
  totalAmount     Decimal
  paidAmount      Decimal               @default(0)
  status          SupplierPaymentStatus @default(UNPAID)
  settledAt       DateTime?
  settledByUserId String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  delivery        SupplierDelivery      @relation(fields: [deliveryId], references: [id])
  settledBy       User?                 @relation("SupplierBillSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)
  payments        SupplierPayment[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
}

model SupplierPayment {
  id               String       @id @default(cuid())
  billId           String
  amount           Decimal
  paymentMethod    String?
  notes            String?
  recordedByUserId String
  paidAt           DateTime     @default(now())
  createdAt        DateTime     @default(now())
  bill             SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  recordedBy       User         @relation("SupplierPaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([billId, paidAt])
  @@index([recordedByUserId, paidAt])
}

model SupplyPurchase {
  id              String   @id @default(cuid())
  purchaseDate    DateTime @db.Date
  itemName        String
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation("SupplyPurchaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([purchaseDate])
  @@index([createdByUserId, purchaseDate])
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  COOK
  BARISTA
  Cabitaan
  SUPPLIER
  CLEANER
  CUSTOMER
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  MYCASH
  GOLIS
  Dahabshiil
  OTHER
}

enum InventoryAlertStatus {
  OK
  LOW
  OUT
}

enum Station {
  CUNTO_SOOMAALI
  FAST_FOOD
  CABITAAN
  BARISTA
}

enum KitchenStationTicketStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum KitchenPickupStatus {
  PREPARING
  READY
  CLAIMED
  DELIVERED
}

enum SupplierDeliveryStatus {
  PENDING_EXTRACTION
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum SupplierPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}
