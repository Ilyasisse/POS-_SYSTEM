generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  String                        @id
  phoneNumber                         String?                       @unique
  fullName                            String
  role                                UserRole                      @default(CASHIER)
  isActive                            Boolean                       @default(true)
  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt
  email                               String                        @unique
  station                             Station?
  orders                              Order[]                       @relation("Cashier")
  waiterOrders                        Order[]                       @relation("WaiterOrders")
  assignedItems                       OrderItem[]                   @relation("AssignedOrderItems")
  claimedKitchenTickets               KitchenTicketState[]          @relation("KitchenTicketClaimant")
  payments                            Payment[]
  shifts                              Shift[]                       @relation("WaiterShifts")
  shiftsSettled                       Shift[]                       @relation("ShiftSettledBy")
  waiterBalanceInitialization         WaiterBalanceInitialization?  @relation("WaiterBalanceOwner")
  waiterBalanceInitializationsCreated WaiterBalanceInitialization[] @relation("WaiterBalanceCreatedBy")
  supplierBillsSettled                SupplierBill[]                @relation("SupplierBillSettledBy")
  supplierPaymentsRecorded            SupplierPayment[]             @relation("SupplierPaymentRecordedBy")
  supplyPurchasesCreated              SupplyPurchase[]              @relation("SupplyPurchaseCreatedBy")
  supplierPurchaseOrdersCreated       SupplierPurchaseOrder[]       @relation("SupplierPurchaseOrderCreatedBy")
  supplierInvoicesCreated             SupplierInvoice[]             @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesFinalized           SupplierInvoice[]             @relation("SupplierInvoiceFinalizedBy")
  supplierInvoicesVoided              SupplierInvoice[]             @relation("SupplierInvoiceVoidedBy")
  supplierInvoiceRecurrencesCreated   SupplierInvoiceRecurrence[]   @relation("SupplierInvoiceRecurrenceCreatedBy")
  supplierInvoiceRecurrencesPaused    SupplierInvoiceRecurrence[]   @relation("SupplierInvoiceRecurrencePausedBy")
  dailyCashSalaryRatesCreated         DailySalaryRate[]             @relation("DailySalaryRateCreatedBy")
  dailyCashSalaryOverrides            DailyCashDay[]                @relation("DailyCashSalaryOverriddenBy")
  dailyCashSalaryPayments             DailyCashDay[]                @relation("DailyCashSalaryPaidBy")
  dailyCashFinalizations              DailyCashDay[]                @relation("DailyCashFinalizedBy")
  dailyCashManualExpensesCreated      DailyCashManualExpense[]      @relation("DailyCashManualExpenseCreatedBy")
  dailyCashSupplierPaymentsRecorded   DailyCashSupplierPayment[]    @relation("DailyCashSupplierPaymentRecordedBy")

  @@index([role, isActive])
  @@index([station])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  iconUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  station   Station?
  products  Product[]

  @@index([isActive, sortOrder])
  @@index([station])
}

model Product {
  id   String @id @default(cuid())
  name String

  description           String?
  imageUrl              String?
  pronunciationAudioUrl String?
  isActive              Boolean               @default(true)
  isPopular             Boolean               @default(false)
  price                 Decimal
  cost                  Decimal?
  categoryId            String
  trackStock            Boolean               @default(false)
  stockQty              Int                   @default(0)
  lowStockThreshold     Int                   @default(5)
  inventoryAlertStatus  InventoryAlertStatus  @default(OK)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  modifiers             Modifier[]
  orderItems            OrderItem[]
  supplierCatalogItems  SupplierCatalogItem[]
  category              Category              @relation(fields: [categoryId], references: [id])

  @@index([categoryId, isActive])
  @@index([trackStock, inventoryAlertStatus])
  @@index([price, name])
}

model InventorySupply {
  id                   String                @id @default(cuid())
  name                 String
  unit                 String                @default("unit")
  stockQty             Int                   @default(0)
  lowStockThreshold    Int                   @default(5)
  inventoryAlertStatus InventoryAlertStatus  @default(OK)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  movements            InventoryMovement[]
  supplierCatalogItems SupplierCatalogItem[]

  @@unique([name, unit])
  @@index([isActive, inventoryAlertStatus])
}

/// Supply-only inventory history.
/// Product stock still lives on Product, but product changes are no longer written here
/// because the Supabase "InventoryMovement"."productId" column was intentionally removed.
model InventoryMovement {
  id             String           @id @default(cuid())
  supplyId       String?
  itemName       String
  itemType       String
  delta          Int
  quantityBefore Int
  quantityAfter  Int
  reason         String
  note           String?
  createdAt      DateTime         @default(now())
  supply         InventorySupply? @relation(fields: [supplyId], references: [id], onDelete: SetNull)

  @@index([supplyId, createdAt])
  @@index([createdAt])
}

model ModifierGroup {
  id         String     @id @default(cuid())
  name       String     @unique
  isRequired Boolean    @default(false)
  minSelect  Int        @default(0)
  maxSelect  Int        @default(5)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  modifiers  Modifier[]

  @@index([isActive])
}

model Modifier {
  id                    String              @id @default(cuid())
  productId             String
  modifierGroupId       String
  name                  String
  price                 Decimal
  pronunciationAudioUrl String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  modifierGroup         ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  product               Product             @relation(fields: [productId], references: [id])
  orderItemModifiers    OrderItemModifier[]

  @@index([productId])
  @@index([modifierGroupId])
}

model Table {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([isActive])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        Int                 @unique @default(autoincrement())
  type               OrderType           @default(DINE_IN)
  status             OrderStatus         @default(OPEN)
  tableId            String?
  cashierId          String?
  waiterId           String?
  notes              String?
  total              Decimal
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedAt           DateTime?
  cashier            User?               @relation("Cashier", fields: [cashierId], references: [id])
  waiter             User?               @relation("WaiterOrders", fields: [waiterId], references: [id])
  table              Table?              @relation(fields: [tableId], references: [id])
  orderItems         OrderItem[]
  payments           Payment[]
  kitchenTicketState KitchenTicketState?

  @@index([status])
  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([waiterId, createdAt])
  @@index([tableId, createdAt])
}

model OrderItem {
  id             String              @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  qty            Int
  unitPrice      Decimal
  lineTotal      Decimal
  createdAt      DateTime            @default(now())
  assignedUserId String?
  station        Station?
  assignedUser   User?               @relation("AssignedOrderItems", fields: [assignedUserId], references: [id])
  order          Order               @relation(fields: [orderId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  modifiers      OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([station])
  @@index([assignedUserId])
}

/// Durable kitchen workflow state for an order. The order and its ticket state
/// are created atomically so Supabase Realtime can always rebuild a snapshot.
model KitchenTicketState {
  orderId             String                      @id
  pickupStatus        KitchenPickupStatus         @default(PREPARING)
  customerName        String?
  claimedByWaiterId   String?
  claimedByWaiterName String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  order               Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedByWaiter     User?                       @relation("KitchenTicketClaimant", fields: [claimedByWaiterId], references: [id], onDelete: SetNull)
  stationStates       KitchenTicketStationState[]

  @@index([pickupStatus, updatedAt])
  @@index([claimedByWaiterId])
}

/// One independently updateable kitchen status per order station.
model KitchenTicketStationState {
  orderId   String
  station   Station
  status    KitchenStationTicketStatus @default(NEW)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  ticket    KitchenTicketState         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@id([orderId, station])
  @@index([station, status])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  modifierId   String
  modifierName String
  qty          Int       @default(1)
  price        Decimal
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, modifierId])
  @@index([modifierId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  cashierId   String
  cashierName String
  method      PaymentMethod
  amountPaid  Decimal
  reference   String?
  createdAt   DateTime      @default(now())
  cashier     User          @relation(fields: [cashierId], references: [id])
  order       Order         @relation(fields: [orderId], references: [id])

  @@unique([method, reference])
  @@index([createdAt])
  @@index([orderId])
  @@index([cashierId, createdAt])
}

model Shift {
  id              String    @id @default(cuid())
  userId          String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingAmount   Decimal   @default(0)
  closingAmount   Decimal?
  businessDate    DateTime? @db.Date
  reportedSales   Decimal?
  settledByUserId String?
  updatedAt       DateTime  @updatedAt
  waiter          User      @relation("WaiterShifts", fields: [userId], references: [id])
  settledBy       User?     @relation("ShiftSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, businessDate])
  @@index([openedAt])
  @@index([userId, openedAt])
  @@index([settledByUserId])
}

model WaiterBalanceInitialization {
  id                    String   @id @default(cuid())
  waiterId              String   @unique
  effectiveBusinessDate DateTime @db.Date
  openingBalance        Decimal
  createdByUserId       String
  createdAt             DateTime @default(now())
  waiter                User     @relation("WaiterBalanceOwner", fields: [waiterId], references: [id])
  createdBy             User     @relation("WaiterBalanceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
}

model Supplier {
  id             String                  @id @default(cuid())
  name           String
  slug           String                  @unique
  contactName    String?
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  bills          SupplierBill[]
  catalogItems   SupplierCatalogItem[]
  purchaseOrders SupplierPurchaseOrder[]
  invoices       SupplierInvoice[]
  recurrences    SupplierInvoiceRecurrence[]

  @@index([isActive, name])
}

model SupplierBill {
  id              String                       @id @default(cuid())
  supplierId      String
  invoiceId       String                       @unique
  totalAmount     Decimal
  paidAmount      Decimal                      @default(0)
  status          SupplierPaymentStatus        @default(UNPAID)
  dueDate         DateTime                     @default(dbgenerated("(CURRENT_DATE + 1)")) @db.Date
  settledAt       DateTime?
  settledByUserId String?
  notes           String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  supplier        Supplier                     @relation(fields: [supplierId], references: [id])
  invoice         SupplierInvoice              @relation(fields: [invoiceId], references: [id])
  settledBy       User?                        @relation("SupplierBillSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)
  payments        SupplierPayment[]
  installments    SupplierInvoiceInstallment[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([status, dueDate])
}

model SupplierPayment {
  id               String                      @id @default(cuid())
  billId           String
  installmentId    String?
  amount           Decimal
  paymentMethod    String?
  notes            String?
  recordedByUserId String
  paidAt           DateTime                    @default(now())
  createdAt        DateTime                    @default(now())
  bill             SupplierBill                @relation(fields: [billId], references: [id], onDelete: Cascade)
  installment      SupplierInvoiceInstallment? @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  recordedBy       User                        @relation("SupplierPaymentRecordedBy", fields: [recordedByUserId], references: [id])
  dailyCashPayment DailyCashSupplierPayment?

  @@index([billId, paidAt])
  @@index([installmentId])
  @@index([recordedByUserId, paidAt])
}

/// A versioned combined salary amount. DailyCashDay stores the resolved amount so
/// a later rate change never changes a historical business day.
model DailySalaryRate {
  id                    String         @id @default(cuid())
  effectiveBusinessDate DateTime       @unique @db.Date
  amount                Decimal        @db.Decimal(14, 2)
  createdByUserId       String
  createdAt             DateTime       @default(now())
  createdBy             User           @relation("DailySalaryRateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  days                  DailyCashDay[]

  @@index([createdByUserId, createdAt])
}

/// Financial record for one POS business day. Its snapshots are populated only
/// when the administrator finalizes the day.
model DailyCashDay {
  id                              String                     @id @default(cuid())
  businessDate                    DateTime                   @unique @db.Date
  salaryAmount                    Decimal                    @db.Decimal(14, 2)
  salaryRateId                    String?
  salaryOverridden                Boolean                    @default(false)
  salaryOverriddenByUserId        String?
  salaryOverriddenAt              DateTime?
  salaryPaidAt                    DateTime?
  salaryPaidByUserId              String?
  salaryRevenueFunded             Decimal                    @default(0) @db.Decimal(14, 2)
  salarySavingsFunded             Decimal                    @default(0) @db.Decimal(14, 2)
  finalizedAt                     DateTime?
  finalizedByUserId               String?
  finalizationFingerprint         String?
  finalizedRevenue                Decimal?                   @db.Decimal(14, 2)
  finalizedPaidExpenses           Decimal?                   @db.Decimal(14, 2)
  finalizedUnpaidRequired         Decimal?                   @db.Decimal(14, 2)
  finalizedRemainingCash          Decimal?                   @db.Decimal(14, 2)
  finalizedSavingsUsed            Decimal?                   @db.Decimal(14, 2)
  finalizedAdditionalSavingsRequired Decimal?                @db.Decimal(14, 2)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  salaryRate                      DailySalaryRate?           @relation(fields: [salaryRateId], references: [id], onDelete: Restrict)
  salaryOverriddenBy              User?                      @relation("DailyCashSalaryOverriddenBy", fields: [salaryOverriddenByUserId], references: [id], onDelete: Restrict)
  salaryPaidBy                    User?                      @relation("DailyCashSalaryPaidBy", fields: [salaryPaidByUserId], references: [id], onDelete: Restrict)
  finalizedBy                     User?                      @relation("DailyCashFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: Restrict)
  manualExpenses                  DailyCashManualExpense[]
  supplierPayments                DailyCashSupplierPayment[]

  @@index([salaryRateId])
  @@index([salaryPaidByUserId])
  @@index([finalizedByUserId])
}

/// A one-time expense paid as part of one Daily Cash day.
model DailyCashManualExpense {
  id             String       @id @default(cuid())
  dailyCashDayId String
  description    String
  amount         Decimal      @db.Decimal(14, 2)
  note           String?
  revenueFunded  Decimal      @db.Decimal(14, 2)
  savingsFunded  Decimal      @db.Decimal(14, 2)
  createdByUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dailyCashDay   DailyCashDay @relation(fields: [dailyCashDayId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("DailyCashManualExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([dailyCashDayId, createdAt])
  @@index([createdByUserId, createdAt])
}

/// Links a real supplier payment to the Daily Cash day and records its funding.
model DailyCashSupplierPayment {
  id                String          @id @default(cuid())
  dailyCashDayId    String
  supplierPaymentId String          @unique
  amount            Decimal         @db.Decimal(14, 2)
  revenueFunded     Decimal         @db.Decimal(14, 2)
  savingsFunded     Decimal         @db.Decimal(14, 2)
  recordedByUserId  String
  createdAt         DateTime        @default(now())
  dailyCashDay      DailyCashDay    @relation(fields: [dailyCashDayId], references: [id], onDelete: Cascade)
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  recordedBy        User            @relation("DailyCashSupplierPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([dailyCashDayId, createdAt])
  @@index([recordedByUserId, createdAt])
}

model SupplierCatalogItem {
  id                 String                      @id @default(cuid())
  supplierId         String
  productId          String?
  inventorySupplyId  String?
  unit               String                      @default("unit")
  unitPrice          Decimal                     @db.Decimal(12, 2)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product            Product?                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventorySupply    InventorySupply?            @relation(fields: [inventorySupplyId], references: [id], onDelete: Restrict)
  purchaseOrderItems SupplierPurchaseOrderItem[]
  invoiceItems       SupplierInvoiceItem[]
  recurrenceItems    SupplierInvoiceRecurrenceItem[]

  @@unique([supplierId, productId])
  @@unique([supplierId, inventorySupplyId])
  @@index([supplierId, isActive])
  @@index([productId])
  @@index([inventorySupplyId])
}

model SupplierPurchaseOrder {
  id                   String                      @id @default(cuid())
  orderNumber          Int                         @unique @default(autoincrement())
  supplierId           String
  status               SupplierPurchaseOrderStatus @default(OPEN)
  expectedDeliveryDate DateTime                    @db.Date
  notes                String?
  totalAmount          Decimal                     @default(0) @db.Decimal(14, 2)
  createdByUserId      String
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  supplier             Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("SupplierPurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                SupplierPurchaseOrderItem[]
  invoices             SupplierInvoice[]

  @@index([supplierId, status, expectedDeliveryDate])
  @@index([status, expectedDeliveryDate])
  @@index([createdByUserId, createdAt])
}

model SupplierPurchaseOrderItem {
  id                    String                @id @default(cuid())
  purchaseOrderId       String
  supplierCatalogItemId String
  itemName              String
  itemUnit              String
  quantity              Decimal               @db.Decimal(12, 3)
  unitPrice             Decimal               @db.Decimal(12, 2)
  lineTotal             Decimal               @db.Decimal(14, 2)
  createdAt             DateTime              @default(now())
  purchaseOrder         SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierCatalogItem   SupplierCatalogItem   @relation(fields: [supplierCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, supplierCatalogItemId])
  @@index([supplierCatalogItemId])
}

model SupplierInvoice {
  id                       String                       @id @default(cuid())
  supplierId               String
  purchaseOrderId          String?
  recurrenceScheduleId     String?
  recurrenceScheduledFor   DateTime?                    @db.Date
  source                   SupplierInvoiceSource
  status                   SupplierInvoiceStatus        @default(DRAFT)
  invoiceNumber            Int                          @unique @default(autoincrement())
  supplierReference        String?
  invoiceDate              DateTime                     @db.Date
  dueDate                  DateTime                     @db.Date
  notes                    String?
  totalAmount              Decimal                      @default(0) @db.Decimal(14, 2)
  receiptObjectPath        String?
  receiptContentType       String?
  uploadedByEmail          String?
  submittedAt              DateTime                     @default(now())
  legacyDeliveryDate       DateTime?
  legacySubtotalAmount     Decimal?                     @db.Decimal(14, 2)
  legacyTaxAmount          Decimal?                     @db.Decimal(14, 2)
  legacyDiscountAmount     Decimal?                     @db.Decimal(14, 2)
  legacyInventoryUpdatedAt DateTime?
  createdByUserId          String?
  finalizedAt              DateTime?
  finalizedByUserId        String?
  voidedAt                 DateTime?
  voidedByUserId           String?
  voidReason               String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  supplier                 Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder            SupplierPurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  templateRecurrence       SupplierInvoiceRecurrence?   @relation("SupplierInvoiceRecurrenceTemplate")
  generatedByRecurrence    SupplierInvoiceRecurrence?   @relation("SupplierInvoiceRecurrenceGenerated", fields: [recurrenceScheduleId], references: [id], onDelete: SetNull)
  createdBy                User?                        @relation("SupplierInvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy              User?                        @relation("SupplierInvoiceFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  voidedBy                 User?                        @relation("SupplierInvoiceVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  items                    SupplierInvoiceItem[]
  installments             SupplierInvoiceInstallment[]
  bill                     SupplierBill?

  @@index([supplierId, status, dueDate])
  @@index([purchaseOrderId, status])
  @@unique([recurrenceScheduleId, recurrenceScheduledFor])
  @@index([recurrenceScheduleId, status])
  @@index([source, status, createdAt])
  @@index([createdByUserId, createdAt])
}

model SupplierInvoiceRecurrence {
  id                String                         @id @default(cuid())
  supplierId        String
  sourceInvoiceId   String                         @unique
  unit              SupplierInvoiceRecurrenceUnit
  interval          Int
  nextRunDate       DateTime                       @db.Date
  anchorDay         Int?
  dueOffsetDays     Int
  invoiceNotes      String?
  isActive          Boolean                        @default(true)
  lastGeneratedAt   DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  pausedAt          DateTime?
  createdByUserId   String
  pausedByUserId    String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  supplier          Supplier                       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceInvoice     SupplierInvoice                @relation("SupplierInvoiceRecurrenceTemplate", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  createdBy         User                           @relation("SupplierInvoiceRecurrenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  pausedBy          User?                          @relation("SupplierInvoiceRecurrencePausedBy", fields: [pausedByUserId], references: [id], onDelete: SetNull)
  items             SupplierInvoiceRecurrenceItem[]
  generatedInvoices SupplierInvoice[]              @relation("SupplierInvoiceRecurrenceGenerated")

  @@index([isActive, nextRunDate])
  @@index([supplierId, isActive])
  @@index([createdByUserId, createdAt])
}

model SupplierInvoiceRecurrenceItem {
  id                    String                    @id @default(cuid())
  recurrenceId          String
  supplierCatalogItemId String
  sequence              Int
  quantity              Decimal                   @db.Decimal(12, 3)
  notes                 String?
  createdAt             DateTime                  @default(now())
  recurrence            SupplierInvoiceRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  supplierCatalogItem   SupplierCatalogItem       @relation(fields: [supplierCatalogItemId], references: [id], onDelete: Restrict, map: "SupplierInvoiceRecurrenceItem_catalogItemId_fkey")

  @@unique([recurrenceId, supplierCatalogItemId], map: "SupplierInvoiceRecurrenceItem_recurrence_catalog_key")
  @@unique([recurrenceId, sequence], map: "SupplierInvoiceRecurrenceItem_recurrence_sequence_key")
  @@index([supplierCatalogItemId])
}

/// A dated portion of a supplier invoice. Existing invoices without rows here
/// keep their legacy single-due-date behaviour until explicitly split.
model SupplierInvoiceInstallment {
  id         String                @id @default(cuid())
  invoiceId  String
  billId     String?
  sequence   Int
  amount     Decimal               @db.Decimal(14, 2)
  paidAmount Decimal               @default(0) @db.Decimal(14, 2)
  status     SupplierPaymentStatus @default(UNPAID)
  dueDate    DateTime              @db.Date
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  invoice    SupplierInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bill       SupplierBill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  payments   SupplierPayment[]

  @@unique([invoiceId, sequence])
  @@index([invoiceId, dueDate])
  @@index([billId, status, dueDate])
}

model SupplierInvoiceItem {
  id                    String               @id @default(cuid())
  invoiceId             String
  supplierCatalogItemId String?
  itemName              String
  itemUnit              String
  quantity              Decimal              @db.Decimal(12, 3)
  unitPrice             Decimal              @db.Decimal(12, 2)
  lineTotal             Decimal              @db.Decimal(14, 2)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  invoice               SupplierInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplierCatalogItem   SupplierCatalogItem? @relation(fields: [supplierCatalogItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, supplierCatalogItemId])
  @@index([supplierCatalogItemId])
}

model SupplyPurchase {
  id              String   @id @default(cuid())
  purchaseDate    DateTime @db.Date
  itemName        String
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation("SupplyPurchaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([purchaseDate])
  @@index([createdByUserId, purchaseDate])
}

