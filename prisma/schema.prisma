generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  String                        @id
  phoneNumber                         String?                       @unique
  fullName                            String
  role                                UserRole                      @default(CASHIER)
  isActive                            Boolean                       @default(true)
  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt
  email                               String                        @unique
  station                             Station?
  orders                              Order[]                       @relation("Cashier")
  waiterOrders                        Order[]                       @relation("WaiterOrders")
  assignedItems                       OrderItem[]                   @relation("AssignedOrderItems")
  claimedKitchenTickets               KitchenTicketState[]          @relation("KitchenTicketClaimant")
  payments                            Payment[]
  shifts                              Shift[]                       @relation("WaiterShifts")
  shiftsSettled                       Shift[]                       @relation("ShiftSettledBy")
  waiterBalanceInitialization         WaiterBalanceInitialization?  @relation("WaiterBalanceOwner")
  waiterBalanceInitializationsCreated WaiterBalanceInitialization[] @relation("WaiterBalanceCreatedBy")
  supplierBillsSettled                SupplierBill[]                @relation("SupplierBillSettledBy")
  supplierPaymentsRecorded            SupplierPayment[]             @relation("SupplierPaymentRecordedBy")
  supplyPurchasesCreated              SupplyPurchase[]              @relation("SupplyPurchaseCreatedBy")
  supplyCatalogItemsCreated           SupplyCatalogItem[]           @relation("SupplyCatalogItemCreatedBy")
  supplyDaysClosed                    SupplyDay[]                   @relation("SupplyDayClosedBy")
  supplyDaysReopened                  SupplyDay[]                   @relation("SupplyDayReopenedBy")
  supplierPurchaseOrdersCreated       SupplierPurchaseOrder[]       @relation("SupplierPurchaseOrderCreatedBy")
  supplierInvoicesCreated             SupplierInvoice[]             @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesFinalized           SupplierInvoice[]             @relation("SupplierInvoiceFinalizedBy")
  supplierInvoicesVoided              SupplierInvoice[]             @relation("SupplierInvoiceVoidedBy")
  dailyCashSalaryRatesCreated         DailySalaryRate[]             @relation("DailySalaryRateCreatedBy")
  dailyCashSalaryOverrides            DailyCashDay[]                @relation("DailyCashSalaryOverriddenBy")
  dailyCashSalaryPayments             DailyCashDay[]                @relation("DailyCashSalaryPaidBy")
  dailyCashFinalizations              DailyCashDay[]                @relation("DailyCashFinalizedBy")
  dailyCashManualExpensesCreated      DailyCashManualExpense[]      @relation("DailyCashManualExpenseCreatedBy")
  dailyCashSupplierPaymentsRecorded   DailyCashSupplierPayment[]    @relation("DailyCashSupplierPaymentRecordedBy")
  auditLogsCreated                    AuditLog[]                    @relation("AuditLogActor")
  cafeSettingsUpdated                 CafeSetting[]                 @relation("CafeSettingUpdatedBy")
  customerOrders                      Order[]                       @relation("CustomerOrders")
  salesAdjustmentsCreated             SalesAdjustment[]             @relation("SalesAdjustmentActor")
  salesAdjustmentsApproved            SalesAdjustment[]             @relation("SalesAdjustmentApprover")
  productCostsChanged                 Product[]                     @relation("ProductStandardCostChangedBy")
  supplyCostsChanged                  InventorySupply[]             @relation("SupplyStandardCostChangedBy")
  recipeVersionsCreated               RecipeVersion[]               @relation("RecipeVersionCreatedBy")
  stockEventsCreated                  StockEvent[]                  @relation("StockEventActor")
  stockEventsApproved                 StockEvent[]                  @relation("StockEventApprover")
  inventoryCountsCreated              InventoryCountSession[]       @relation("InventoryCountCreatedBy")
  inventoryCountsSubmitted            InventoryCountSession[]       @relation("InventoryCountSubmittedBy")
  inventoryCountsApproved             InventoryCountSession[]       @relation("InventoryCountApprovedBy")
  kitchenTransitions                  KitchenTransitionEvent[]      @relation("KitchenTransitionActor")
  kitchenTargetsUpdated               KitchenPreparationTarget[]    @relation("KitchenTargetUpdatedBy")
  kitchenQualityEvents                KitchenQualityEvent[]         @relation("KitchenQualityActor")
  incidentsReported                   OperationalIncident[]         @relation("IncidentReporter")
  incidentsAssigned                   OperationalIncident[]         @relation("IncidentAssignee")
  cleaningRunsAssigned                CleaningChecklistRun[]        @relation("CleaningRunAssignee")
  cleaningRunsCompleted               CleaningChecklistRun[]        @relation("CleaningRunCompletedBy")
  cleaningTasksCompleted              CleaningChecklistRunTask[]    @relation("CleaningTaskCompletedBy")
  dailyCashSupplyPaymentsRecorded     DailyCashSupplyPayment[]      @relation("DailyCashSupplyPaymentRecordedBy")
  employmentProfile                   EmploymentProfile?
  scheduledShifts                     ScheduledShift[]             @relation("ScheduledShiftWorker")
  scheduledShiftsCreated              ScheduledShift[]             @relation("ScheduledShiftCreator")
  clockEvents                         ClockEvent[]                 @relation("ClockEventWorker")
  attendanceApprovals                 AttendanceRecord[]           @relation("AttendanceApprover")
  attendanceRecords                   AttendanceRecord[]           @relation("AttendanceWorker")
  payrollAdjustmentsCreated           PayrollAdjustment[]          @relation("PayrollAdjustmentActor")
  payrollAdjustmentsApproved          PayrollAdjustment[]          @relation("PayrollAdjustmentApprover")
  payrollRunsCreated                  PayrollRun[]                 @relation("PayrollRunCreator")
  payrollRunsApproved                 PayrollRun[]                 @relation("PayrollRunApprover")
  payrollRunsFinalized                PayrollRun[]                 @relation("PayrollRunFinalizer")
  payrollAdjustments                  PayrollAdjustment[]          @relation("PayrollAdjustmentWorker")
  payrollLines                        PayrollLine[]                @relation("PayrollLineWorker")
  expenseCategoriesCreated            ExpenseCategory[]            @relation("ExpenseCategoryCreator")
  expensesRecorded                    ExpenseTransaction[]         @relation("ExpenseActor")
  expensesApproved                    ExpenseTransaction[]         @relation("ExpenseApprover")
  ownerWithdrawalsRecorded            OwnerWithdrawal[]            @relation("OwnerWithdrawalActor")
  supplierReceivingsRecorded          SupplierReceiving[]          @relation("SupplierReceivingActor")
  customerFeedbackRecorded            CustomerFeedback[]           @relation("CustomerFeedbackActor")
  complaintsAssigned                  ComplaintCase[]              @relation("ComplaintAssignee")
  complaintsResolved                  ComplaintCase[]              @relation("ComplaintResolver")
  complaintsRecorded                  ComplaintCase[]              @relation("ComplaintActor")
  reportExports                       ReportExportAudit[]          @relation("ReportExportActor")

  @@index([role, isActive])
  @@index([station])
}

model CafeSetting {
  id                     String   @id @default("default")
  businessName           String   @default("Mash Allah Cafe")
  currencyCode           String   @default("USD")
  timezone               String   @default("Africa/Nairobi")
  businessDayStartMinute Int      @default(420)
  businessDayEndMinute   Int      @default(300)
  weekStartDay           Int      @default(6)
  updatedByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  updatedBy              User?    @relation("CafeSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// Versioned compensation is deliberately separated from operational staff data.
model EmploymentProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  compensationType CompensationType
  dailyRate        Decimal?           @db.Decimal(14, 2)
  monthlySalary    Decimal?           @db.Decimal(14, 2)
  effectiveFrom    DateTime           @db.Date
  effectiveTo      DateTime?          @db.Date
  status           EmploymentStatus   @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, effectiveFrom])
}

model AttendancePolicy {
  id                    String   @id @default("default")
  shiftMinutes          Int      @default(480)
  graceMinutes          Int      @default(10)
  overtimeThresholdMinutes Int   @default(480)
  timezone              String   @default("Africa/Nairobi")
  updatedAt             DateTime @updatedAt
}

model ScheduledShift {
  id              String           @id @default(cuid())
  workerId        String
  startsAt        DateTime
  endsAt          DateTime
  station         Station?
  status          ScheduledShiftStatus @default(SCHEDULED)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  worker          User             @relation("ScheduledShiftWorker", fields: [workerId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("ScheduledShiftCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  attendance      AttendanceRecord?

  @@index([workerId, startsAt])
  @@index([status, startsAt])
}

/// Raw clock records are append-only. Attendance approval stores the reviewed result.
model ClockEvent {
  id        String         @id @default(cuid())
  workerId  String
  type      ClockEventType
  occurredAt DateTime      @default(now())
  note      String?
  createdAt DateTime       @default(now())
  worker    User           @relation("ClockEventWorker", fields: [workerId], references: [id], onDelete: Restrict)

  @@index([workerId, occurredAt])
}

model AttendanceRecord {
  id                     String           @id @default(cuid())
  workerId               String
  scheduledShiftId       String?          @unique
  businessDate           DateTime         @db.Date
  status                 AttendanceStatus @default(PENDING)
  clockInAt              DateTime?
  clockOutAt             DateTime?
  workedMinutes          Int              @default(0)
  lateMinutes            Int              @default(0)
  approvedOvertimeMinutes Int             @default(0)
  absenceReason          String?
  approvedByUserId       String?
  approvedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  worker                 User             @relation("AttendanceWorker", fields: [workerId], references: [id], onDelete: Restrict)
  scheduledShift         ScheduledShift?  @relation(fields: [scheduledShiftId], references: [id], onDelete: SetNull)
  approvedBy             User?            @relation("AttendanceApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([workerId, businessDate])
  @@index([businessDate, status])
}

model PayrollAdjustment {
  id               String                @id @default(cuid())
  workerId         String
  periodStart      DateTime              @db.Date
  periodEnd        DateTime              @db.Date
  type             PayrollAdjustmentType
  amount           Decimal               @db.Decimal(14, 2)
  reason           String
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  worker           User                  @relation("PayrollAdjustmentWorker", fields: [workerId], references: [id], onDelete: Restrict)
  createdBy        User                  @relation("PayrollAdjustmentActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?                 @relation("PayrollAdjustmentApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([workerId, periodStart, periodEnd])
  @@index([approvedAt])
}

model PayrollRun {
  id               String            @id @default(cuid())
  periodStart      DateTime          @db.Date
  periodEnd        DateTime          @db.Date
  status           PayrollRunStatus  @default(DRAFT)
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  finalizedByUserId String?
  finalizedAt      DateTime?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        User              @relation("PayrollRunCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?             @relation("PayrollRunApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  finalizedBy      User?             @relation("PayrollRunFinalizer", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  lines            PayrollLine[]

  @@index([status, periodStart, periodEnd])
}

model PayrollLine {
  id                    String     @id @default(cuid())
  payrollRunId          String
  workerId              String
  compensationType      CompensationType
  basePay               Decimal    @db.Decimal(14, 2)
  overtimePay           Decimal    @default(0) @db.Decimal(14, 2)
  additions             Decimal    @default(0) @db.Decimal(14, 2)
  deductions            Decimal    @default(0) @db.Decimal(14, 2)
  netPay                Decimal    @db.Decimal(14, 2)
  attendanceDays        Int        @default(0)
  overtimeMinutes       Int        @default(0)
  snapshot              Json
  createdAt             DateTime   @default(now())
  payrollRun            PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  worker                User       @relation("PayrollLineWorker", fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, workerId])
  @@index([workerId, createdAt])
}

model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String?
  action            String
  entityType        String
  entityId          String
  reason            String?
  previousValue     Json?
  newValue          Json?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())
  actor             User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model ExpenseCategory {
  id              String   @id @default(cuid())
  name            String   @unique
  isActive        Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation("ExpenseCategoryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  expenses        ExpenseTransaction[]
}

model ExpenseTransaction {
  id               String            @id @default(cuid())
  categoryId       String
  vendor           String?
  amount           Decimal           @db.Decimal(14, 2)
  paymentMethod    String?
  paidAt           DateTime          @db.Date
  receiptReference String?
  isFixed          Boolean           @default(false)
  isRecurring      Boolean           @default(false)
  status           ExpenseStatus     @default(PENDING)
  note             String?
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("ExpenseActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?             @relation("ExpenseApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([paidAt, status])
  @@index([categoryId, paidAt])
}

model OwnerWithdrawal {
  id               String   @id @default(cuid())
  amount           Decimal  @db.Decimal(14, 2)
  withdrawnAt      DateTime @db.Date
  reason           String
  receiptReference String?
  createdByUserId  String
  createdAt        DateTime @default(now())
  createdBy        User     @relation("OwnerWithdrawalActor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([withdrawnAt])
}

model SupplierReceiving {
  id                    String                @id @default(cuid())
  purchaseOrderId       String                @unique
  receivedAt            DateTime              @default(now())
  receivedByUserId      String
  qualityRating         Int?
  rejectionQuantity     Decimal?              @db.Decimal(12, 3)
  rejectionReason       String?
  completionNote        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  purchaseOrder         SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy            User                  @relation("SupplierReceivingActor", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items                 SupplierReceivingItem[]
}

model SupplierReceivingItem {
  id                    String             @id @default(cuid())
  receivingId           String
  purchaseOrderItemId   String
  expectedQuantity      Decimal            @db.Decimal(12, 3)
  receivedQuantity      Decimal            @db.Decimal(12, 3)
  createdAt             DateTime           @default(now())
  receiving             SupplierReceiving  @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  purchaseOrderItem     SupplierPurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@unique([receivingId, purchaseOrderItemId])
}

model CustomerFeedback {
  id               String   @id @default(cuid())
  orderId          String?
  rating           Int?
  comment          String?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy        User?    @relation("CustomerFeedbackActor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model ComplaintCase {
  id               String          @id @default(cuid())
  orderId          String?
  category         ComplaintCategory
  priority         ComplaintPriority @default(MEDIUM)
  status           ComplaintStatus @default(OPEN)
  description      String
  assignedToUserId String?
  resolvedByUserId String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo       User?           @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedBy       User?           @relation("ComplaintResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdBy        User?           @relation("ComplaintActor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assignedToUserId, status])
}

model ReportExportAudit {
  id               String   @id @default(cuid())
  actorUserId      String
  report           String
  format           String
  filters          Json
  createdAt        DateTime @default(now())
  actor            User     @relation("ReportExportActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  iconUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  station   Station?
  products  Product[]

  @@index([isActive, sortOrder])
  @@index([station])
}

model Product {
  id   String @id @default(cuid())
  name String

  description                 String?
  imageUrl                    String?
  pronunciationAudioUrl       String?
  isActive                    Boolean               @default(true)
  isPopular                   Boolean               @default(false)
  price                       Decimal
  cost                        Decimal?              @db.Decimal(14, 6)
  categoryId                  String
  trackStock                  Boolean               @default(false)
  stockQty                    Decimal               @default(0) @db.Decimal(18, 6)
  lowStockThreshold           Decimal               @default(5) @db.Decimal(18, 6)
  canonicalUnit               CanonicalUnit         @default(PIECE)
  quantityCoverage            InventoryDataCoverage @default(COMPLETE)
  standardCostUpdatedAt       DateTime?
  standardCostUpdatedByUserId String?
  inventoryAlertStatus        InventoryAlertStatus  @default(OK)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  modifiers                   Modifier[]
  orderItems                  OrderItem[]
  supplierCatalogItems        SupplierCatalogItem[]
  category                    Category              @relation(fields: [categoryId], references: [id])
  standardCostUpdatedBy       User?                 @relation("ProductStandardCostChangedBy", fields: [standardCostUpdatedByUserId], references: [id], onDelete: SetNull)
  recipeVersions              RecipeVersion[]
  stockEvents                 StockEvent[]
  inventoryCountLines         InventoryCountLine[]

  @@index([categoryId, isActive])
  @@index([trackStock, inventoryAlertStatus])
  @@index([price, name])
  @@index([standardCostUpdatedByUserId])
}

model InventorySupply {
  id                          String                    @id @default(cuid())
  name                        String
  unit                        String                    @default("unit")
  stockQty                    Decimal                   @default(0) @db.Decimal(18, 6)
  lowStockThreshold           Decimal                   @default(5) @db.Decimal(18, 6)
  canonicalUnit               CanonicalUnit?
  quantityCoverage            InventoryDataCoverage     @default(LEGACY_INCOMPLETE)
  standardUnitCost            Decimal?                  @db.Decimal(14, 6)
  standardCostUpdatedAt       DateTime?
  standardCostUpdatedByUserId String?
  inventoryAlertStatus        InventoryAlertStatus      @default(OK)
  isActive                    Boolean                   @default(true)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  movements                   InventoryMovement[]
  supplierCatalogItems        SupplierCatalogItem[]
  standardCostUpdatedBy       User?                     @relation("SupplyStandardCostChangedBy", fields: [standardCostUpdatedByUserId], references: [id], onDelete: SetNull)
  purchaseUnitConversions     InventoryUnitConversion[]
  recipeIngredients           RecipeIngredient[]
  stockEvents                 StockEvent[]
  inventoryCountLines         InventoryCountLine[]

  @@unique([name, unit])
  @@index([isActive, inventoryAlertStatus])
  @@index([standardCostUpdatedByUserId])
}

/// Supply-only inventory history.
/// Product stock still lives on Product, but product changes are no longer written here
/// because the Supabase "InventoryMovement"."productId" column was intentionally removed.
model InventoryMovement {
  id                       String                @id @default(cuid())
  supplyId                 String?
  itemName                 String
  itemType                 String
  delta                    Decimal               @db.Decimal(18, 6)
  quantityBefore           Decimal               @db.Decimal(18, 6)
  quantityAfter            Decimal               @db.Decimal(18, 6)
  canonicalUnit            CanonicalUnit?
  dataCoverage             InventoryDataCoverage @default(LEGACY_INCOMPLETE)
  standardUnitCostSnapshot Decimal?              @db.Decimal(14, 6)
  reason                   String
  note                     String?
  createdAt                DateTime              @default(now())
  supply                   InventorySupply?      @relation(fields: [supplyId], references: [id], onDelete: SetNull)

  @@index([supplyId, createdAt])
  @@index([createdAt])
}

model ModifierGroup {
  id         String     @id @default(cuid())
  name       String     @unique
  isRequired Boolean    @default(false)
  minSelect  Int        @default(0)
  maxSelect  Int        @default(5)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  modifiers  Modifier[]

  @@index([isActive])
}

model Modifier {
  id                    String              @id @default(cuid())
  productId             String
  modifierGroupId       String
  name                  String
  price                 Decimal
  pronunciationAudioUrl String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  modifierGroup         ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  product               Product             @relation(fields: [productId], references: [id])
  orderItemModifiers    OrderItemModifier[]

  @@index([productId])
  @@index([modifierGroupId])
}

model Table {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([isActive])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        Int                 @unique @default(autoincrement())
  type               OrderType           @default(DINE_IN)
  status             OrderStatus         @default(OPEN)
  tableId            String?
  cashierId          String?
  waiterId           String?
  customerId         String?
  notes              String?
  total              Decimal
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedAt           DateTime?
  cashier            User?               @relation("Cashier", fields: [cashierId], references: [id])
  waiter             User?               @relation("WaiterOrders", fields: [waiterId], references: [id])
  customer           User?               @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  table              Table?              @relation(fields: [tableId], references: [id])
  orderItems         OrderItem[]
  payments           Payment[]
  kitchenTicketState KitchenTicketState?
  salesAdjustments   SalesAdjustment[]
  feedback           CustomerFeedback[]
  complaints         ComplaintCase[]

  @@index([status])
  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([waiterId, createdAt])
  @@index([tableId, createdAt])
  @@index([customerId, closedAt])
  @@index([status, closedAt])
}

model OrderItem {
  id                   String                @id @default(cuid())
  orderId              String
  productId            String
  productName          String
  qty                  Int
  unitPrice            Decimal
  lineTotal            Decimal
  unitCostSnapshot     Decimal?              @db.Decimal(14, 6)
  costSnapshotSource   CostSnapshotSource?
  recipeVersionId      String?
  createdAt            DateTime              @default(now())
  assignedUserId       String?
  station              Station?
  assignedUser         User?                 @relation("AssignedOrderItems", fields: [assignedUserId], references: [id])
  order                Order                 @relation(fields: [orderId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  recipeVersion        RecipeVersion?        @relation(fields: [recipeVersionId], references: [id], onDelete: SetNull)
  modifiers            OrderItemModifier[]
  salesAdjustments     SalesAdjustment[]
  kitchenQualityEvents KitchenQualityEvent[]

  @@index([orderId])
  @@index([productId])
  @@index([station])
  @@index([assignedUserId])
  @@index([recipeVersionId])
}

model InventoryUnitConversion {
  id                String          @id @default(cuid())
  supplyId          String
  purchaseUnit      String
  canonicalQuantity Decimal         @db.Decimal(18, 6)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  supply            InventorySupply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([supplyId, purchaseUnit])
  @@index([supplyId, isActive])
}

model RecipeVersion {
  id              String                @id @default(cuid())
  productId       String
  version         Int
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  yieldQuantity   Decimal               @default(1) @db.Decimal(18, 6)
  standardCost    Decimal?              @db.Decimal(14, 6)
  costCoverage    InventoryDataCoverage @default(MISSING_COST)
  isActive        Boolean               @default(true)
  createdByUserId String
  createdAt       DateTime              @default(now())
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("RecipeVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  ingredients     RecipeIngredient[]
  orderItems      OrderItem[]

  @@unique([productId, version])
  @@index([productId, effectiveFrom, effectiveTo])
}

model RecipeIngredient {
  id                       String          @id @default(cuid())
  recipeVersionId          String
  supplyId                 String
  quantity                 Decimal         @db.Decimal(18, 6)
  standardUnitCostSnapshot Decimal?        @db.Decimal(14, 6)
  createdAt                DateTime        @default(now())
  recipeVersion            RecipeVersion   @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  supply                   InventorySupply @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, supplyId])
  @@index([supplyId])
}

model StockEvent {
  id                       String                @id @default(cuid())
  productId                String?
  supplyId                 String?
  type                     StockEventType
  quantityDelta            Decimal               @db.Decimal(18, 6)
  quantityBefore           Decimal               @db.Decimal(18, 6)
  quantityAfter            Decimal               @db.Decimal(18, 6)
  canonicalUnit            CanonicalUnit
  standardUnitCostSnapshot Decimal?              @db.Decimal(14, 6)
  dataCoverage             InventoryDataCoverage @default(COMPLETE)
  reason                   String
  actorUserId              String?
  approvedByUserId         String?
  sourceType               String?
  sourceId                 String?
  occurredAt               DateTime              @default(now())
  createdAt                DateTime              @default(now())
  product                  Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  supply                   InventorySupply?      @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  actor                    User?                 @relation("StockEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  approvedBy               User?                 @relation("StockEventApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  inventoryCountLine       InventoryCountLine?

  @@index([productId, occurredAt])
  @@index([supplyId, occurredAt])
  @@index([type, occurredAt])
  @@index([sourceType, sourceId])
}

model InventoryCountSession {
  id                String               @id @default(cuid())
  businessDate      DateTime             @db.Date
  status            InventoryCountStatus @default(DRAFT)
  reason            String?
  createdByUserId   String
  submittedByUserId String?
  approvedByUserId  String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy         User                 @relation("InventoryCountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy       User?                @relation("InventoryCountSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedBy        User?                @relation("InventoryCountApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lines             InventoryCountLine[]

  @@index([businessDate, status])
}

model InventoryCountLine {
  id                       String                @id @default(cuid())
  sessionId                String
  productId                String?
  supplyId                 String?
  canonicalUnit            CanonicalUnit
  expectedQuantity         Decimal               @db.Decimal(18, 6)
  physicalQuantity         Decimal               @db.Decimal(18, 6)
  varianceQuantity         Decimal               @db.Decimal(18, 6)
  standardUnitCostSnapshot Decimal?              @db.Decimal(14, 6)
  dataCoverage             InventoryDataCoverage @default(COMPLETE)
  stockEventId             String?               @unique
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  session                  InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product                  Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  supply                   InventorySupply?      @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  stockEvent               StockEvent?           @relation(fields: [stockEventId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@unique([sessionId, supplyId])
  @@index([sessionId])
  @@index([productId])
  @@index([supplyId])
}

model SalesAdjustment {
  id               String              @id @default(cuid())
  orderId          String
  orderItemId      String?
  type             SalesAdjustmentType
  amount           Decimal             @db.Decimal(12, 2)
  quantity         Decimal?            @db.Decimal(12, 3)
  reason           String
  actorUserId      String
  approvedByUserId String
  metadata         Json?
  createdAt        DateTime            @default(now())
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem        OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  actor            User                @relation("SalesAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  approvedBy       User                @relation("SalesAdjustmentApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([orderItemId, createdAt])
  @@index([type, createdAt])
  @@index([actorUserId, createdAt])
  @@index([approvedByUserId, createdAt])
}

/// Durable kitchen workflow state for an order. The order and its ticket state
/// are created atomically so Supabase Realtime can always rebuild a snapshot.
model KitchenTicketState {
  orderId             String                      @id
  pickupStatus        KitchenPickupStatus         @default(PREPARING)
  customerName        String?
  claimedByWaiterId   String?
  claimedByWaiterName String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  order               Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedByWaiter     User?                       @relation("KitchenTicketClaimant", fields: [claimedByWaiterId], references: [id], onDelete: SetNull)
  stationStates       KitchenTicketStationState[]
  transitions         KitchenTransitionEvent[]
  qualityEvents       KitchenQualityEvent[]

  @@index([pickupStatus, updatedAt])
  @@index([claimedByWaiterId])
}

/// One independently updateable kitchen status per order station.
model KitchenTicketStationState {
  orderId   String
  station   Station
  status    KitchenStationTicketStatus @default(NEW)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  ticket    KitchenTicketState         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@id([orderId, station])
  @@index([station, status])
}

model KitchenPreparationTarget {
  id              String   @id @default(cuid())
  station         Station  @unique
  targetMinutes   Int
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User     @relation("KitchenTargetUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([updatedByUserId])
}

model KitchenTransitionEvent {
  id                    String                      @id @default(cuid())
  orderId               String
  station               Station?
  type                  KitchenTransitionType
  fromStationStatus     KitchenStationTicketStatus?
  toStationStatus       KitchenStationTicketStatus?
  fromPickupStatus      KitchenPickupStatus?
  toPickupStatus        KitchenPickupStatus?
  targetMinutesSnapshot Int?
  actorUserId           String?
  occurredAt            DateTime                    @default(now())
  createdAt             DateTime                    @default(now())
  ticket                KitchenTicketState          @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  actor                 User?                       @relation("KitchenTransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, station, occurredAt])
  @@index([type, occurredAt])
  @@index([actorUserId, occurredAt])
}

model KitchenQualityEvent {
  id          String                  @id @default(cuid())
  orderId     String
  orderItemId String?
  station     Station?
  type        KitchenQualityEventType
  reason      String
  actorUserId String
  occurredAt  DateTime                @default(now())
  createdAt   DateTime                @default(now())
  ticket      KitchenTicketState      @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  orderItem   OrderItem?              @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  actor       User                    @relation("KitchenQualityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@index([type, occurredAt])
  @@index([station, occurredAt])
  @@index([actorUserId, occurredAt])
}

model OperationalIncident {
  id               String                  @id @default(cuid())
  type             OperationalIncidentType
  severity         IncidentSeverity
  status           IncidentStatus          @default(OPEN)
  title            String
  description      String
  station          Station?
  reportedByUserId String
  assignedToUserId String?
  startedAt        DateTime                @default(now())
  resolvedAt       DateTime?
  resolutionNotes  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  reportedBy       User                    @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  assignedTo       User?                   @relation("IncidentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([type, status, startedAt])
  @@index([severity, status])
  @@index([assignedToUserId, status])
}

model CleaningChecklistTemplate {
  id        String                  @id @default(cuid())
  name      String
  station   Station?
  schedule  String
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  tasks     CleaningChecklistTask[]
  runs      CleaningChecklistRun[]

  @@index([station, isActive])
}

model CleaningChecklistTask {
  id         String                     @id @default(cuid())
  templateId String
  label      String
  sortOrder  Int                        @default(0)
  isRequired Boolean                    @default(true)
  createdAt  DateTime                   @default(now())
  template   CleaningChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  runTasks   CleaningChecklistRunTask[]

  @@index([templateId, sortOrder])
}

model CleaningChecklistRun {
  id                String                     @id @default(cuid())
  templateId        String
  station           Station?
  scheduledFor      DateTime
  status            CleaningRunStatus          @default(PENDING)
  assignedToUserId  String?
  completedByUserId String?
  startedAt         DateTime?
  completedAt       DateTime?
  evidenceNote      String?
  evidenceUrl       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  template          CleaningChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assignedTo        User?                      @relation("CleaningRunAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  completedBy       User?                      @relation("CleaningRunCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  tasks             CleaningChecklistRunTask[]

  @@index([status, scheduledFor])
  @@index([assignedToUserId, status])
  @@index([station, scheduledFor])
}

model CleaningChecklistRunTask {
  id                String                @id @default(cuid())
  runId             String
  taskId            String
  completed         Boolean               @default(false)
  completedAt       DateTime?
  completedByUserId String?
  evidenceText      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  run               CleaningChecklistRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  task              CleaningChecklistTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  completedBy       User?                 @relation("CleaningTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([runId, taskId])
  @@index([completedByUserId, completedAt])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  modifierId   String
  modifierName String
  qty          Int       @default(1)
  price        Decimal
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, modifierId])
  @@index([modifierId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  cashierId   String
  cashierName String
  method      PaymentMethod
  amountPaid  Decimal
  reference   String?
  createdAt   DateTime      @default(now())
  cashier     User          @relation(fields: [cashierId], references: [id])
  order       Order         @relation(fields: [orderId], references: [id])

  @@unique([method, reference])
  @@index([createdAt])
  @@index([orderId])
  @@index([cashierId, createdAt])
}

model Shift {
  id              String    @id @default(cuid())
  userId          String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingAmount   Decimal   @default(0)
  closingAmount   Decimal?
  businessDate    DateTime? @db.Date
  reportedSales   Decimal?
  settledByUserId String?
  updatedAt       DateTime  @updatedAt
  waiter          User      @relation("WaiterShifts", fields: [userId], references: [id])
  settledBy       User?     @relation("ShiftSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, businessDate])
  @@index([openedAt])
  @@index([userId, openedAt])
  @@index([settledByUserId])
}

model WaiterBalanceInitialization {
  id                    String   @id @default(cuid())
  waiterId              String   @unique
  effectiveBusinessDate DateTime @db.Date
  openingBalance        Decimal
  createdByUserId       String
  createdAt             DateTime @default(now())
  waiter                User     @relation("WaiterBalanceOwner", fields: [waiterId], references: [id])
  createdBy             User     @relation("WaiterBalanceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
}

model Supplier {
  id             String                  @id @default(cuid())
  name           String
  slug           String                  @unique
  contactName    String?
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  bills          SupplierBill[]
  catalogItems   SupplierCatalogItem[]
  purchaseOrders SupplierPurchaseOrder[]
  invoices       SupplierInvoice[]

  @@index([isActive, name])
}

model SupplierBill {
  id              String                       @id @default(cuid())
  supplierId      String
  invoiceId       String                       @unique
  totalAmount     Decimal
  paidAmount      Decimal                      @default(0)
  status          SupplierPaymentStatus        @default(UNPAID)
  dueDate         DateTime                     @default(dbgenerated("(CURRENT_DATE + 1)")) @db.Date
  settledAt       DateTime?
  settledByUserId String?
  notes           String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  supplier        Supplier                     @relation(fields: [supplierId], references: [id])
  invoice         SupplierInvoice              @relation(fields: [invoiceId], references: [id])
  settledBy       User?                        @relation("SupplierBillSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)
  payments        SupplierPayment[]
  installments    SupplierInvoiceInstallment[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([status, dueDate])
}

model SupplierPayment {
  id               String                      @id @default(cuid())
  billId           String
  installmentId    String?
  amount           Decimal
  paymentMethod    String?
  notes            String?
  recordedByUserId String
  paidAt           DateTime                    @default(now())
  createdAt        DateTime                    @default(now())
  bill             SupplierBill                @relation(fields: [billId], references: [id], onDelete: Cascade)
  installment      SupplierInvoiceInstallment? @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  recordedBy       User                        @relation("SupplierPaymentRecordedBy", fields: [recordedByUserId], references: [id])
  dailyCashPayment DailyCashSupplierPayment?

  @@index([billId, paidAt])
  @@index([installmentId])
  @@index([recordedByUserId, paidAt])
}

/// A versioned combined salary amount. DailyCashDay stores the resolved amount so
/// a later rate change never changes a historical business day.
model DailySalaryRate {
  id                    String         @id @default(cuid())
  effectiveBusinessDate DateTime       @unique @db.Date
  amount                Decimal        @db.Decimal(14, 2)
  createdByUserId       String
  createdAt             DateTime       @default(now())
  createdBy             User           @relation("DailySalaryRateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  days                  DailyCashDay[]

  @@index([createdByUserId, createdAt])
}

/// Financial record for one POS business day. Its snapshots are populated only
/// when the administrator finalizes the day.
model DailyCashDay {
  id                                 String                     @id @default(cuid())
  businessDate                       DateTime                   @unique @db.Date
  salaryAmount                       Decimal                    @db.Decimal(14, 2)
  salaryRateId                       String?
  salaryOverridden                   Boolean                    @default(false)
  salaryOverriddenByUserId           String?
  salaryOverriddenAt                 DateTime?
  salaryPaidAt                       DateTime?
  salaryPaidByUserId                 String?
  salaryRevenueFunded                Decimal                    @default(0) @db.Decimal(14, 2)
  salarySavingsFunded                Decimal                    @default(0) @db.Decimal(14, 2)
  finalizedAt                        DateTime?
  finalizedByUserId                  String?
  finalizationFingerprint            String?
  finalizedRevenue                   Decimal?                   @db.Decimal(14, 2)
  finalizedPaidExpenses              Decimal?                   @db.Decimal(14, 2)
  finalizedUnpaidRequired            Decimal?                   @db.Decimal(14, 2)
  finalizedRemainingCash             Decimal?                   @db.Decimal(14, 2)
  finalizedSavingsUsed               Decimal?                   @db.Decimal(14, 2)
  finalizedAdditionalSavingsRequired Decimal?                   @db.Decimal(14, 2)
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt
  salaryRate                         DailySalaryRate?           @relation(fields: [salaryRateId], references: [id], onDelete: Restrict)
  salaryOverriddenBy                 User?                      @relation("DailyCashSalaryOverriddenBy", fields: [salaryOverriddenByUserId], references: [id], onDelete: Restrict)
  salaryPaidBy                       User?                      @relation("DailyCashSalaryPaidBy", fields: [salaryPaidByUserId], references: [id], onDelete: Restrict)
  finalizedBy                        User?                      @relation("DailyCashFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: Restrict)
  manualExpenses                     DailyCashManualExpense[]
  supplierPayments                   DailyCashSupplierPayment[]
  supplyPayments                     DailyCashSupplyPayment[]

  @@index([salaryRateId])
  @@index([salaryPaidByUserId])
  @@index([finalizedByUserId])
}

/// A one-time expense paid as part of one Daily Cash day.
model DailyCashManualExpense {
  id              String       @id @default(cuid())
  dailyCashDayId  String
  description     String
  amount          Decimal      @db.Decimal(14, 2)
  note            String?
  revenueFunded   Decimal      @db.Decimal(14, 2)
  savingsFunded   Decimal      @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  dailyCashDay    DailyCashDay @relation(fields: [dailyCashDayId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("DailyCashManualExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([dailyCashDayId, createdAt])
  @@index([createdByUserId, createdAt])
}

/// Links a real supplier payment to the Daily Cash day and records its funding.
model DailyCashSupplierPayment {
  id                String          @id @default(cuid())
  dailyCashDayId    String
  supplierPaymentId String          @unique
  amount            Decimal         @db.Decimal(14, 2)
  revenueFunded     Decimal         @db.Decimal(14, 2)
  savingsFunded     Decimal         @db.Decimal(14, 2)
  recordedByUserId  String
  createdAt         DateTime        @default(now())
  dailyCashDay      DailyCashDay    @relation(fields: [dailyCashDayId], references: [id], onDelete: Cascade)
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  recordedBy        User            @relation("DailyCashSupplierPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([dailyCashDayId, createdAt])
  @@index([recordedByUserId, createdAt])
}

/// A payment toward a closed daily supply batch, funded by one Daily Cash day.
model DailyCashSupplyPayment {
  id               String       @id @default(cuid())
  dailyCashDayId   String
  supplyDayId      String
  amount           Decimal      @db.Decimal(14, 2)
  revenueFunded    Decimal      @db.Decimal(14, 2)
  savingsFunded    Decimal      @db.Decimal(14, 2)
  recordedByUserId String
  createdAt        DateTime     @default(now())
  dailyCashDay     DailyCashDay @relation(fields: [dailyCashDayId], references: [id], onDelete: Cascade)
  supplyDay        SupplyDay    @relation(fields: [supplyDayId], references: [id], onDelete: Restrict)
  recordedBy       User         @relation("DailyCashSupplyPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([dailyCashDayId, createdAt])
  @@index([supplyDayId, createdAt])
  @@index([recordedByUserId, createdAt])
}

model SupplierCatalogItem {
  id                 String                      @id @default(cuid())
  supplierId         String
  productId          String?
  inventorySupplyId  String?
  unit               String                      @default("unit")
  unitPrice          Decimal                     @db.Decimal(12, 2)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product            Product?                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventorySupply    InventorySupply?            @relation(fields: [inventorySupplyId], references: [id], onDelete: Restrict)
  purchaseOrderItems SupplierPurchaseOrderItem[]
  invoiceItems       SupplierInvoiceItem[]

  @@unique([supplierId, productId])
  @@unique([supplierId, inventorySupplyId])
  @@index([supplierId, isActive])
  @@index([productId])
  @@index([inventorySupplyId])
}

model SupplierPurchaseOrder {
  id                   String                      @id @default(cuid())
  orderNumber          Int                         @unique @default(autoincrement())
  supplierId           String
  status               SupplierPurchaseOrderStatus @default(OPEN)
  expectedDeliveryDate DateTime                    @db.Date
  notes                String?
  totalAmount          Decimal                     @default(0) @db.Decimal(14, 2)
  createdByUserId      String
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  emergencyPurchase    Boolean                     @default(false)
  supplier             Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("SupplierPurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                SupplierPurchaseOrderItem[]
  invoices             SupplierInvoice[]
  receiving            SupplierReceiving?

  @@index([supplierId, status, expectedDeliveryDate])
  @@index([status, expectedDeliveryDate])
  @@index([createdByUserId, createdAt])
}

model SupplierPurchaseOrderItem {
  id                    String                @id @default(cuid())
  purchaseOrderId       String
  supplierCatalogItemId String
  itemName              String
  itemUnit              String
  quantity              Decimal               @db.Decimal(12, 3)
  unitPrice             Decimal               @db.Decimal(12, 2)
  lineTotal             Decimal               @db.Decimal(14, 2)
  createdAt             DateTime              @default(now())
  purchaseOrder         SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierCatalogItem   SupplierCatalogItem   @relation(fields: [supplierCatalogItemId], references: [id], onDelete: Restrict)
  receivingItems        SupplierReceivingItem[]

  @@unique([purchaseOrderId, supplierCatalogItemId])
  @@index([supplierCatalogItemId])
}

model SupplierInvoice {
  id                       String                       @id @default(cuid())
  supplierId               String
  purchaseOrderId          String?
  source                   SupplierInvoiceSource
  status                   SupplierInvoiceStatus        @default(DRAFT)
  invoiceNumber            Int                          @unique @default(autoincrement())
  supplierReference        String?
  invoiceDate              DateTime                     @db.Date
  dueDate                  DateTime                     @db.Date
  notes                    String?
  totalAmount              Decimal                      @default(0) @db.Decimal(14, 2)
  receiptObjectPath        String?
  receiptContentType       String?
  uploadedByEmail          String?
  submittedAt              DateTime                     @default(now())
  legacyDeliveryDate       DateTime?
  legacySubtotalAmount     Decimal?                     @db.Decimal(14, 2)
  legacyTaxAmount          Decimal?                     @db.Decimal(14, 2)
  legacyDiscountAmount     Decimal?                     @db.Decimal(14, 2)
  legacyInventoryUpdatedAt DateTime?
  createdByUserId          String?
  finalizedAt              DateTime?
  finalizedByUserId        String?
  voidedAt                 DateTime?
  voidedByUserId           String?
  voidReason               String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  supplier                 Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder            SupplierPurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy                User?                        @relation("SupplierInvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy              User?                        @relation("SupplierInvoiceFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  voidedBy                 User?                        @relation("SupplierInvoiceVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  items                    SupplierInvoiceItem[]
  installments             SupplierInvoiceInstallment[]
  bill                     SupplierBill?

  @@index([supplierId, status, dueDate])
  @@index([purchaseOrderId, status])
  @@index([source, status, createdAt])
  @@index([createdByUserId, createdAt])
}

/// A dated portion of a supplier invoice. Existing invoices without rows here
/// keep their legacy single-due-date behaviour until explicitly split.
model SupplierInvoiceInstallment {
  id         String                @id @default(cuid())
  invoiceId  String
  billId     String?
  sequence   Int
  amount     Decimal               @db.Decimal(14, 2)
  paidAmount Decimal               @default(0) @db.Decimal(14, 2)
  status     SupplierPaymentStatus @default(UNPAID)
  dueDate    DateTime              @db.Date
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  invoice    SupplierInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bill       SupplierBill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  payments   SupplierPayment[]

  @@unique([invoiceId, sequence])
  @@index([invoiceId, dueDate])
  @@index([billId, status, dueDate])
}

model SupplierInvoiceItem {
  id                    String               @id @default(cuid())
  invoiceId             String
  supplierCatalogItemId String?
  itemName              String
  itemUnit              String
  quantity              Decimal              @db.Decimal(12, 3)
  unitPrice             Decimal              @db.Decimal(12, 2)
  lineTotal             Decimal              @db.Decimal(14, 2)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  invoice               SupplierInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplierCatalogItem   SupplierCatalogItem? @relation(fields: [supplierCatalogItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, supplierCatalogItemId])
  @@index([supplierCatalogItemId])
}

model SupplyCatalogItem {
  id               String           @id @default(cuid())
  name             String
  unit             String
  defaultUnitPrice Decimal          @db.Decimal(12, 2)
  isActive         Boolean          @default(true)
  createdByUserId  String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        User             @relation("SupplyCatalogItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  purchases        SupplyPurchase[]

  @@unique([name, unit])
  @@index([isActive, name])
  @@index([createdByUserId, createdAt])
}

model SupplyDay {
  id               String                   @id @default(cuid())
  purchaseDate     DateTime                 @unique @db.Date
  closedTotal      Decimal?                 @db.Decimal(14, 2)
  closedAt         DateTime?
  closedByUserId   String?
  reopenedAt       DateTime?
  reopenedByUserId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  closedBy         User?                    @relation("SupplyDayClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  reopenedBy       User?                    @relation("SupplyDayReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: Restrict)
  purchases        SupplyPurchase[]         @relation("SupplyPurchasesByDate")
  payments         DailyCashSupplyPayment[]

  @@index([closedAt, purchaseDate])
  @@index([closedByUserId])
  @@index([reopenedByUserId])
}

model SupplyPurchase {
  id              String             @id @default(cuid())
  purchaseDate    DateTime           @db.Date
  catalogItemId   String?
  itemName        String
  unit            String             @default("unit")
  quantity        Decimal            @db.Decimal(12, 3)
  unitPrice       Decimal            @db.Decimal(12, 2)
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       User               @relation("SupplyPurchaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  catalogItem     SupplyCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  day             SupplyDay          @relation("SupplyPurchasesByDate", fields: [purchaseDate], references: [purchaseDate], onDelete: Restrict)

  @@index([purchaseDate])
  @@index([catalogItemId])
  @@index([createdByUserId, purchaseDate])
}

